# ==============================================================================
# Dockerfile.dev - Umbral Backend (Development Optimized)
# ==============================================================================

# STAGE 1 - builder
FROM gradle:9.6.1-jdk25-alpine AS builder

WORKDIR /build

# Cache dependencies
COPY build.gradle.kts settings.gradle.kts gradle.properties ./
COPY gradle ./gradle
RUN --mount=type=cache,target=/root/.gradle,sharing=locked \
    gradle dependencies --no-daemon

# Compile and package (skipping tests)
COPY src ./src
RUN --mount=type=cache,target=/root/.gradle,sharing=locked \
    gradle clean bootJar -x test --no-daemon

# Extract layers
RUN java -Djarmode=layertools -jar build/libs/*.jar extract --destination /build/layers

# STAGE 2 - runner
FROM eclipse-temurin:25-jre-alpine AS runner

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app

# Copy layers
COPY --from=builder /build/layers/dependencies          ./
COPY --from=builder /build/layers/spring-boot-loader    ./
COPY --from=builder /build/layers/snapshot-dependencies ./
COPY --from=builder /build/layers/application           ./

RUN chown -R appuser:appgroup /app
USER appuser

# Expose API and Socket.IO ports
ENV PORT=8080
EXPOSE 8080 8081

# Simplified JVM options for dev (No Telemetry)
ENV JAVA_TOOL_OPTIONS="\
    -Xms256m \
    -Xmx512m \
    -Djava.security.egd=file:/dev/./urandom \
    -Dfile.encoding=UTF-8 \
    -Duser.timezone=America/Lima"

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:${PORT}/actuator/health || exit 1

ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
